__pycache__/
*.py[cod]
*.sqlite3
db.sqlite3
.env
venv/
.venv/
media/
staticfiles/
*.log

# --- Node / clients (client-electron, client-web) ---
# Note : client-electron/build/ contient des assets sources (icônes) versionnés,
# ce n'est pas un dossier de sortie — ne pas l'ignorer.
node_modules/
dist/
dist-electron/
release/
*.tsbuildinfo
npm-debug.log*

# client-web/dist/ EST versionné (exception au dist/ ci-dessus) : O2switch n'a
# pas Node côté serveur (Setup Python App uniquement), donc WhiteNoise sert ce
# build pré-compilé directement — un `git pull` doit suffire à déployer, voir
# config/settings.py::WHITENOISE_ROOT et deploy/README.md.
!client-web/dist/

# --- Scripts de vérification locaux (chemins machine spécifiques, non versionnés) ---
client-electron/_*_tmp*.mjs

# --- État interne Claude Code (spécifique à la machine) ---
.claude/scheduled_tasks.lock
