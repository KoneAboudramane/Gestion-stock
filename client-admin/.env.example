# Adresse de l'API Django. En local : http://localhost:8000/api
# En production (site sur un sous-domaine, ex. admin.mondomaine.com) : l'adresse
# complète de l'API, ex. https://mondomaine.com/api — et ajouter l'origine du
# site d'administration à CORS_ALLOWED_ORIGINS dans le .env du serveur.
VITE_API_BASE_URL=http://localhost:8000/api
