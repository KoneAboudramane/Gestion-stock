# Utilisé par "npm run build:android" (vite --mode capacitor) : dans l'appli,
# les pages ne sont pas servies par Django, l'adresse de l'API doit donc être
# complète. Elle DOIT être en HTTPS avec un certificat valide (Android refuse
# un certificat auto-signé). Serveur O2switch du domaine digi-ba.com (depuis le 07/11/2026).
VITE_API_BASE_URL=https://gestion.stock.digi-ba.com/api
