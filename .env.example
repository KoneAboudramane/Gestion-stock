# Copier ce fichier en ".env" (ignoré par git) et remplir les valeurs réelles.
# Sans fichier .env, le projet tourne exactement comme en dev (SQLite, DEBUG=True).

# --- Sécurité ---
# Générer une vraie valeur, ex. :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-moi-en-production
DJANGO_DEBUG=False
# Domaine(s) réels séparés par des virgules, ex. api.monboutique.com
DJANGO_ALLOWED_HOSTS=exemple.com
# À activer (True) une fois le HTTPS confirmé fonctionnel devant l'appli (nginx/Passenger).
DJANGO_SSL_REDIRECT=False

# --- CORS (client web) ---
# Origine(s) du client-web autorisées à appeler l'API, séparées par des virgules.
# En dev : http://localhost:5174 (port par défaut de client-web).
CORS_ALLOWED_ORIGINS=http://localhost:5174

# --- Base de données ---
# "sqlite3" (défaut, aucune variable ci-dessous nécessaire), "postgresql" (VPS)
# ou "mysql" (mutualisés type o2switch qui n'offrent pas PostgreSQL — voir
# deploy/README.md, parcours B). o2switch : DB_HOST est en général "localhost",
# DB_NAME/DB_USER sont préfixés par ton identifiant cPanel (ex. cpaneluser_gestion_stock).
DB_ENGINE=mysql
DB_NAME=gestion_stock
DB_USER=gestion_stock
DB_PASSWORD=change-moi
DB_HOST=localhost
DB_PORT=3306

# --- Email (réinitialisation du mot de passe du Patron) ---
# Sans ces variables, les emails s'affichent dans la console du serveur au lieu
# d'être réellement envoyés (pratique en dev, à configurer avant la production).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemple.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@exemple.com
EMAIL_HOST_PASSWORD=change-moi
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@exemple.com
# Reçoit un email à chaque nouvelle demande d'inscription (écran Inscription).
ADMIN_EMAIL=admin@exemple.com
